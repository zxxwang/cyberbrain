# 由 app/config/settings.py 对应生成：key 必须与 Settings 字段同名，否则服务启动报错

# 服务配置
APP_NAME=CyberBrain
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Qdrant配置
QDRANT_URL=http://localhost:6333
QDRANT_DIMENSION=1024
QDRANT_BRIEF_COLLECTION=brief_memories
QDRANT_EPISODIC_COLLECTION=episodic_memories

# Mem0配置
MEM0_BRIEF_HISTORY_DB=./data/brief_history.db
MEM0_EPISODIC_HISTORY_DB=./data/episodic_history.db

# Embedding配置（Qwen via OpenAI-compatible API）
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=your-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIMENSION=1024

# LLM配置（Doubao via Ark API）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_SYSTEM_ONE_URL=https://ark.cn-beijing.volces.com/api/v1/systemone
ARK_API_KEY=your-api-key
DOUBAO_MODEL_PRO=doubao-seed-2-0-pro-260215
DOUBAO_MODEL_LITE=doubao-seed-2-1-lite-260915
DOUBAO_MODEL_CHARACTER=doubao-seed-character-260628

# Brief稠密检索阈值
BRIEF_DENSE_SCORE_THRESHOLD=0.3

# Brief检索的相关性过滤（qwen3-rerank交叉编码器）
BRIEF_RERANK_ENABLED=True
BRIEF_RERANK_MIN_SCORE=0.42
BRIEF_RERANK_CANDIDATES=10

# 新旧记忆冲突排序
BRIEF_RECENCY_TIEBREAK_MARGIN=0.05
BRIEF_CONFLICT_SIMILARITY=0.85

# Query Rewriting & Reranking
RERANK_MODEL=qwen3-rerank
QUERY_REWRITE_NUM=1
RERANK_CANDIDATE_SIZE=15
RERANK_SKIP_THRESHOLD=0.8
EPISODIC_RERANK_MIN_SCORE=0.35

# 记忆衰减配置
DECAY_FACTOR=0.96
DECAY_MIN_WEIGHT=0.2
REACTIVATION_THRESHOLD=0.55

# Redis配置（前额叶工作记忆）
REDIS_URL=redis://localhost:6379/0

# MongoDB配置（Agent生命事件记录）
MONGODB_URI=mongodb://user:password@localhost:27017
MONGODB_DB_NAME=cyberbrain
MONGODB_COLLECTION_LIFE_EVENT=agent_life_event

# 前额叶工作记忆（短时记忆队列 wm:{agent_id}:stm + 压缩队列 wm:{agent_id}:stm:compress）
PFC_STM_MAX_LEN=100
PFC_STM_COMPRESS_COUNT=50
PFC_COMPRESS_MAX_BLOCKS=16
PFC_LOCK_TTL=300
PFC_DAILY_HOUR=4

# 赛博大脑 react
BRAIN_BRIEF_TOP_K=10
BRAIN_EPISODIC_TOP_K=5
BRAIN_KNOWLEDGE_SCORE_THRESHOLD=0.5
BRAIN_KNOWLEDGE_INJECT_TOP_K=2
BRAIN_KNOWLEDGE_CONTENT_CHARS=1200
BRAIN_SYSTEM2_TEMPERATURE=0.3
BRAIN_SYSTEM2_MAX_TOKENS=400
BRAIN_SYSTEM3_TEMPERATURE=0.5
BRAIN_SYSTEM3_MAX_TOKENS=1000

# 路由：System1的noul/choice概率 -> 走哪条认知路径（阈值需用探针标定）
BRAIN_ROUTE_REASONING_THRESHOLD=0.6
BRAIN_ROUTE_MEMORY_THRESHOLD=0.6
BRAIN_ROUTE_THINK_THRESHOLD=0.5
BRAIN_ROUTE_MIN_ACTION_CONFIDENCE=0.55
BRAIN_ROUTE_HOSTILE_MAX_CONFLICT=0.4
BRAIN_SYSTEM1_RECENT_TURNS=4

# 待办
TODO_DEDUP_SIMILARITY=0.6
TODO_DEDUP_WINDOW_HOURS=24

# Worker配置
DECAY_WORKER_INTERVAL=86400
THOUGHT_GENERATOR_INTERVAL=3600
TASK_REMINDER_INTERVAL=3600
